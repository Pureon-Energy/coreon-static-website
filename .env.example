# Only needed for local builds. On GitHub, the workflow sets these automatically
# (FORM_ENDPOINT and PLAUSIBLE_DOMAIN come from Settings > Secrets and variables > Actions > Variables).

# Full public address, including the sub-path if there is one.
SITE_URL=https://coreon.dk

# "/repo-name" when the site lives at user.github.io/repo-name, empty on a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Optional form service, e.g. https://formspree.io/f/xxxxxxx
# Without it the contact form opens the visitor's email app addressed to hello@coreon.dk.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional: cookieless analytics. Set to the domain registered in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
